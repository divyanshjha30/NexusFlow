# Point these at the Spring Boot API. Left unset, Vite proxies /api and /ws
# to localhost:8080 (see vite.config.ts).
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# Cognito lives in floci on dj-pc (requires Tailscale).
VITE_COGNITO_DOMAIN=http://dj-pc:4566
VITE_COGNITO_CLIENT_ID=4dadaf1b4c3a4895a05801c8f6
VITE_REDIRECT_URI=http://localhost:5173/login
